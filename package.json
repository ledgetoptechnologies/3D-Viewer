{
  "name": "viewer-local-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic, local-only Viewer technology demonstration",
  "license": "ISC",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "postinstall": "node scripts/patch-3d-tiles-renderer.mjs && node scripts/install-basis-transcoder.mjs",
    "start": "vite --host 127.0.0.1 --port 8080 --strictPort",
    "build": "node scripts/verify-fixtures.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8080 --strictPort",
    "test": "node --test test/demo.test.mjs && npm run build"
  },
  "dependencies": {
    "3d-tiles-renderer": "0.5.1",
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.14"
  },
  "devDependencies": { "vite": "8.2.1" }
}
