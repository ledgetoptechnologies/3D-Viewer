# Copy this file to .env and fill in real values before `docker compose up`.

# --- WebODM REST API -------------------------------------------------------
# Base URL of your self-hosted WebODM instance (no trailing slash).
WEBODM_API_URL=https://webodm.example.com

# Use a DEDICATED, least-privilege WebODM account for this viewer (view-only
# permission on the projects it should expose) — do not use an admin account.
WEBODM_USERNAME=viewer-readonly
WEBODM_PASSWORD=change-me

# --- Read-only WebODM storage -----------------------------------------------
# Host path that mirrors WO_MEDIA_DIR from WebODM's OWN docker-compose.yml
# (the same directory it bind-mounts as `${WO_MEDIA_DIR}:/webodm/app/media`
# into its webapp/worker containers). To find the real value, run this on
# the WebODM host, in the directory containing WebODM's docker-compose.yml:
#   grep WO_MEDIA_DIR .env
# WebODM runs on a separate host from this viewer, so that same directory
# (or the TrueNAS export it's mounted from) must be re-shared (NFS/SMB) and
# mounted onto THIS Docker host at the path below before `docker compose up`.
# Mounted into the viewer container read-only — never point this at
# WO_DB_DIR (WebODM's Postgres data).
WEBODM_MEDIA_PATH=/mnt/webodm-media

# --- Optional LOD derivatives ------------------------------------------------
# Writable host path for pre-built 3D-tiles/EPT derivatives (see README
# "Known limitations" — these are NOT produced by WebODM automatically).
# Leave as-is (a local folder) if you don't have any yet.
DERIVATIVES_PATH=./data/derivatives

# --- Admin login / sessions --------------------------------------------------
# Required. Protects the internal viewer (project browsing, sync trigger,
# share-link management) — NOT the same as a WebODM password. Also usable as
# a Bearer token for automation (e.g. `curl -H "Authorization: Bearer $ADMIN_PASSWORD"`).
ADMIN_PASSWORD=change-me-too

# Recommended in production. HMAC signing key for admin/share session cookies.
# If unset, a random one is generated at startup — fine for local dev, but it
# means every restart logs everyone out and invalidates all share sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Misc --------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=10
VIEWER_PORT=8080

# Share links embedded cross-origin (e.g. an <iframe> on a different domain
# such as LTDS Ops) require the cookie attributes `SameSite=None; Secure`,
# which in turn require this app to be served over HTTPS in production
# (typically via a reverse proxy terminating TLS in front of this container).
