# Copy this file to .env and fill in real values before `docker compose up`.

# --- Public viewer / LTDS integration ---------------------------------------
# Exact external HTTPS origin used by Ops and client portal embeds.
PUBLIC_BASE_URL=https://viewer.example.com
EXPECTED_HOST=viewer.example.com

# Prefer an immutable CI tag in production, for example:
# ghcr.io/your-org/3d-viewer:sha-0123456
VIEWER_IMAGE=ltds-3d-viewer:latest

# Comma-separated exact HTTPS origins that may embed the Viewer.
ALLOWED_EMBED_ORIGINS=https://ops.example.com,https://client.example.com

# Number of trusted reverse proxies between the browser and this container.
# Cloudflare -> Nginx -> container is 2. Use 1 only when Nginx is the sole
# proxy, and never expose the origin directly when trusting forwarded headers.
TRUST_PROXY_HOPS=2

# Shared only between LTDS Ops and the Viewer backend. Generate independently
# from SESSION_SECRET; never expose it to browser code.
SERVICE_AUTH_KEY_ID=ops-v1
SERVICE_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional zero-downtime key rotation. When set, this JSON object replaces
# the single key above; keep old+new during rollout, then remove the old key.
# SERVICE_AUTH_KEYS_JSON={"ops-v1":"old-32-plus-char-secret","ops-v2":"new-32-plus-char-secret"}
# Simpler two-key overlap alternative (set both or neither): deploy Viewer
# with previous+current, switch Ops to current, then remove previous.
# SERVICE_AUTH_PREVIOUS_KEY_ID=ops-v0
# SERVICE_AUTH_PREVIOUS_SECRET=previous-secret-with-at-least-32-characters

# Production normally delegates administration to Ops. Set this true only for
# break-glass local administration and then provide a 16+ character password.
EMERGENCY_ADMIN_ENABLED=false

# --- WebODM REST API -------------------------------------------------------
# Base URL of your self-hosted WebODM instance (no trailing slash).
WEBODM_API_URL=https://webodm.example.com

# Use a DEDICATED, least-privilege WebODM account for this viewer (view-only
# permission on the projects it should expose) — do not use an admin account.
WEBODM_USERNAME=viewer-readonly
WEBODM_PASSWORD=change-me
WEBODM_ENABLED=true

# --- Read-only WebODM storage -----------------------------------------------
# Host path that mirrors WO_MEDIA_DIR from WebODM's OWN docker-compose.yml
# (the same directory it bind-mounts as `${WO_MEDIA_DIR}:/webodm/app/media`
# into its webapp/worker containers). To find the real value, run this on
# the WebODM host, in the directory containing WebODM's docker-compose.yml:
#   grep WO_MEDIA_DIR .env
# WebODM runs on a separate host from this viewer, so that same directory
# (or the TrueNAS export it's mounted from) must be re-shared (NFS/SMB) and
# mounted onto THIS Docker host at the path below before `docker compose up`.
# Mounted into the viewer container read-only — never point this at
# WO_DB_DIR (WebODM's Postgres data).
WEBODM_MEDIA_PATH=/mnt/webodm-media

# --- Optional LOD derivatives ------------------------------------------------
# Writable host path for pre-built 3D-tiles/EPT derivatives (see README
# "Known limitations" — these are NOT produced by WebODM automatically).
# Leave as-is (a local folder) if you don't have any yet.
DERIVATIVES_PATH=./data/derivatives

# --- Emergency admin / sessions ---------------------------------------------
# Leave blank when EMERGENCY_ADMIN_ENABLED=false (normal production mode).
# If break-glass administration is enabled, use a unique value of 16+ chars.
ADMIN_PASSWORD=

# Required in production. HMAC signing key for viewer/share session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
VIEWER_SESSION_TTL_SECONDS=1800
SESSION_GRANT_TTL_SECONDS=60

# SQLite registry location inside the persistent viewer-data volume.
DATABASE_PATH=/app/data/viewer.sqlite

# Optional Nginx internal location from deploy/nginx-viewer.conf.example.
# When set, Node authorizes requests but Nginx sends the large response body.
X_ACCEL_REDIRECT_PREFIX=/_viewer_assets

# --- Misc --------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=10
VIEWER_PORT=8080

# Share links embedded cross-origin (e.g. an <iframe> on a different domain
# such as LTDS Ops) require the cookie attributes `SameSite=None; Secure`,
# which in turn require this app to be served over HTTPS in production
# (typically via a reverse proxy terminating TLS in front of this container).
