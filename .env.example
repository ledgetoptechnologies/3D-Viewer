# Copy this file to .env and fill in real values before `docker compose up`.

# --- Public viewer / LTDS integration ---------------------------------------
# These production defaults already exist in docker-compose.yml. Override only
# for a separate staging hostname.
PUBLIC_BASE_URL=https://viewer.ledgetopdroneservices.com
EXPECTED_HOST=viewer.ledgetopdroneservices.com
OPS_BASE_URL=https://ops.ledgetopdroneservices.com

# Prefer an immutable CI tag in production, for example:
# ghcr.io/your-org/3d-viewer:sha-0123456
VIEWER_IMAGE=ghcr.io/ledgetoptechnologies/3d-viewer:latest

# Comma-separated exact HTTPS origins that may embed the Viewer.
ALLOWED_EMBED_ORIGINS=https://ops.ledgetopdroneservices.com,https://client.ledgetopdroneservices.com

# cloudflared -> container is one trusted proxy. Use 2 only when an Nginx
# reverse proxy is deliberately inserted between cloudflared and the Viewer.
TRUST_PROXY_HOPS=1

# Shared only between LTDS Ops and the Viewer backend. Generate independently
# from SESSION_SECRET; never expose it to browser code.
SERVICE_AUTH_KEY_ID=ops-v1
SERVICE_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional zero-downtime key rotation. When set, this JSON object replaces
# the single key above; keep old+new during rollout, then remove the old key.
# SERVICE_AUTH_KEYS_JSON={"ops-v1":"old-32-plus-char-secret","ops-v2":"new-32-plus-char-secret"}
# Simpler two-key overlap alternative (set both or neither): deploy Viewer
# with previous+current, switch Ops to current, then remove previous.
# SERVICE_AUTH_PREVIOUS_KEY_ID=ops-v0
# SERVICE_AUTH_PREVIOUS_SECRET=previous-secret-with-at-least-32-characters

# --- WebODM REST API -------------------------------------------------------
# Base URL of your self-hosted WebODM instance (no trailing slash).
WEBODM_API_URL=https://webodm.example.com

# Use a DEDICATED, least-privilege WebODM account for this viewer (view-only
# permission on the projects it should expose) — do not use an admin account.
WEBODM_USERNAME=viewer-readonly
WEBODM_PASSWORD=change-me
WEBODM_ENABLED=true

# --- Read-only WebODM storage -----------------------------------------------
# The production compose file uses the known TrueNAS WebODM media dataset.
# Fixed in docker-compose.yml: /mnt/Plugins/App_Data/WebODM/Media

# --- Optional LOD derivatives ------------------------------------------------
# The production compose file uses the known Viewer derivatives dataset.
# Create this directory even if it starts empty.
# Fixed in docker-compose.yml: /mnt/Plugins/App_Data/Model-Viewer/Derivatives

# --- Persistent data / sessions ---------------------------------------------
# The Viewer database persists in /mnt/Plugins/App_Data/Model-Viewer/Data.
# The local password-admin shell is intentionally unavailable in Compose.

# Required in production. HMAC signing key for viewer/share session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
VIEWER_SESSION_TTL_SECONDS=1800
SESSION_GRANT_TTL_SECONDS=60

# SQLite registry location inside the persistent TrueNAS Data bind mount.
DATABASE_PATH=/app/data/viewer.sqlite

# Optional Nginx internal location from deploy/nginx-viewer.conf.example.
# When set, Node authorizes requests but Nginx sends the large response body.
X_ACCEL_REDIRECT_PREFIX=

# --- Misc --------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=10
VIEWER_PORT=8080

# Share links embedded cross-origin (e.g. an <iframe> on a different domain
# such as LTDS Ops) require the cookie attributes `SameSite=None; Secure`,
# which in turn require this app to be served over HTTPS in production
# (typically via a reverse proxy terminating TLS in front of this container).
