# Copy this template to the persistent TrueNAS path
# /mnt/Plugins/App_Data/Model-Viewer/Config/viewer.env, set mode 600, and put
# every runtime override and secret there. Never commit the populated file.
# Pass the same file to Compose with `--env-file` so VIEWER_PORT/image
# substitutions and the containers use one source of truth.
VIEWER_ENV_FILE=/mnt/Plugins/App_Data/Model-Viewer/Config/viewer.env

# --- Public viewer / LTDS integration ---------------------------------------
# These are the production application defaults copied into the persistent
# environment file. Override them only for a separate staging hostname.
PUBLIC_BASE_URL=https://viewer.ledgetopdroneservices.com
EXPECTED_HOST=viewer.ledgetopdroneservices.com
OPS_BASE_URL=https://ops.ledgetopdroneservices.com
# HMAC-only automation host used for Viewer callbacks and live client-share
# authorization checks. It must not be the Cloudflare Access-protected Ops
# hostname and redirects are rejected.
OPS_AUTOMATION_BASE_URL=https://incoming.ledgetopdroneservices.com

# Required: use the official latest image for normal guarded TrueNAS updates.
# A reviewed CI sha-<commit> tag or @sha256 digest may be used to freeze a
# specific release. Other mutable tags are rejected by scripts/update-truenas.sh.
VIEWER_IMAGE=ghcr.io/ledgetoptechnologies/3d-viewer:latest

# Comma-separated exact HTTPS origins that may embed the Viewer.
ALLOWED_EMBED_ORIGINS=https://ops.ledgetopdroneservices.com,https://client.ledgetopdroneservices.com

# External Nginx resolves Cloudflare's client address, overwrites
# X-Forwarded-For, then connects to Viewer: from Express this is one trusted
# HTTP proxy hop. Increase only if another reviewed proxy is inserted after it.
TRUST_PROXY_HOPS=1

# Optional staged hardening (disabled initially): an independent 32-byte
# base64url secret injected only by external Nginx as X-Viewer-Proxy-Secret.
# When ready, generate it with the command below and configure the same value
# in Nginx's protected secret store. It is unrelated to all HMAC/session secrets.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PROXY_SHARED_SECRET=

# Optional exact socket-source IP/CIDR allowlist for external Nginx. Leave
# empty initially or when Docker/NAT does not preserve a stable source. If this
# is enabled later, also include 127.0.0.1/32 and ::1/128 for the container's
# local healthcheck. Never list untrusted client/Cloudflare ranges.
TRUSTED_PROXY_ADDRESSES=

# Must exactly equal Ops VIEWER_SERVICE_HMAC_SECRET. Generate independently
# from all other secrets and never expose it to browser code.
SERVICE_AUTH_KEY_ID=ops-v1
SERVICE_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional zero-downtime key rotation. When set, this JSON object replaces
# the single key above; keep old+new during rollout, then remove the old key.
# SERVICE_AUTH_KEYS_JSON={"ops-v1":"old-32-plus-char-secret","ops-v2":"new-32-plus-char-secret"}

# --- Read-only WebODM storage -----------------------------------------------
# The production compose file uses the known TrueNAS WebODM media dataset for
# mounted task-folder migration. Exported all.zip files can instead be placed
# under DATASET_IMPORT_MOUNT. Neither path needs WebODM API credentials.
# Fixed in docker-compose.yml: /mnt/Plugins/App_Data/WebODM/Media

# --- Optional LOD derivatives ------------------------------------------------
# The production compose file uses the known Viewer derivatives dataset.
# Create this directory even if it starts empty.
# Fixed in docker-compose.yml: /mnt/Plugins/App_Data/Model-Viewer/Derivatives

# --- Durable processing platform -------------------------------------------
# This installation uses the Viewer management/processing platform. Compose
# defaults this to true while preserving an explicit false override. The
# viewer-worker always starts; with false it publishes an idle heartbeat and
# performs no processing work.
PROCESSING_PLATFORM_ENABLED=true

# Exact NodeODM/ClusterODM origins only (scheme + host + optional port, no
# path). Provider redirects are rejected. Do not put the WebODM application
# URL here; leave this empty until the actual provider origin is known.
PROCESSING_PROVIDER_ORIGINS=

# One-time network admission boundary for providers created later in the Ops
# UI. Only IP-literal endpoints inside these private LANs are eligible; exact
# origins above remain supported. This does not store provider credentials.
PROCESSING_PROVIDER_ALLOWED_CIDRS=192.168.50.0/24,192.168.10.0/24

# Legacy provider-token map. New deployments should leave this empty and use
# the Ops Processing UI to store/rotate provider credentials without restart.
PROCESSING_PROVIDER_TOKENS_JSON={}

# One-time installation key used to encrypt provider credentials stored in the
# Viewer database. Required when processing is enabled. Generate once with
# `openssl rand -hex 32`, keep it in this mode-600 file, and back it up. This is
# not a Cloudflare key and must not reuse any session or HMAC secret.
PROVIDER_CREDENTIALS_KEY_ID=provider-v1
PROVIDER_CREDENTIALS_KEY=replace-with-64-lowercase-hex-characters
# During key rotation only, map old key IDs to their 64-hex keys until all
# stored credentials have been re-encrypted under the current key.
# PROVIDER_CREDENTIALS_KEYS_JSON={"provider-old":"old-64-hex-key"}

# Durable completion/failure callbacks to LTDS Ops. The URL must be exactly
# the automation origin plus /api/viewer/events, with no query or fragment.
# Generate an independent 32+ character secret. VIEWER_EVENT_SECRET must
# exactly equal Ops VIEWER_EVENT_HMAC_SECRET; VIEWER_EVENT_KEY_ID identifies
# that key. The same direction-specific key signs source-authorization
# introspection with a distinct canonical path/body. It is not SERVICE_AUTH.
VIEWER_EVENT_URL=https://incoming.ledgetopdroneservices.com/api/viewer/events
VIEWER_EVENT_KEY_ID=viewer-v1
VIEWER_EVENT_SECRET=replace-with-independent-32-plus-character-secret
# Optional bounded key-rotation overlap accepted by callback receivers.
# VIEWER_EVENT_PREVIOUS_KEY_ID=viewer-v0
# VIEWER_EVENT_PREVIOUS_SECRET=replace-with-previous-32-plus-character-secret

# Client-origin public Viewer shares are off by default. Enabling requires the
# exact automation origin and event-direction HMAC above. Each unlock/session/
# asset authorization is live-revalidated with a maximum five-second positive
# lease; staff shares bypass this dependency and remain viewable during Ops or
# provider outages.
CLIENT_VIEWER_SHARES_ENABLED=false

# Published Viewer sessions can be bound to an immutable LTDS model-association
# authorization. Keep revocation off until Ops sends descriptors on every new
# session and revokes the exact prior version on every association transition.
PUBLISHED_SESSION_SOURCE_REVOCATION_ENABLED=false

# --- Persistent data / sessions ---------------------------------------------
# The Viewer database persists in the Docker-managed `ltds-viewer-storage`
# volume at /app/storage/data/viewer.sqlite.
# The local password-admin shell is intentionally unavailable in Compose.

# Required in production and Viewer-only. Never reuse either Ops HMAC secret.
# HMAC signing key for viewer/share session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
DEFAULT_UNITS=imperial

# Production Compose fixes the SQLite registry at
# /app/storage/data/viewer.sqlite.

# Compose fixes X_ACCEL_REDIRECT_PREFIX empty. The Viewer authorizes and streams
# byte ranges directly; the external Nginx must proxy those responses without
# caching capability URLs.

# --- Misc --------------------------------------------------------------------
VIEWER_PORT=8088
# Bind only the LAN address reachable by the separately managed Nginx. Set to
# 192.168.10.80 instead when that is the routed subnet. Use 0.0.0.0 for both
# interfaces only with host firewall restrictions and the proxy gate enabled.
VIEWER_BIND_ADDRESS=192.168.50.80

# Share links embedded cross-origin (e.g. an <iframe> on a different domain
# such as LTDS Ops) require the cookie attributes `SameSite=None; Secure`,
# which in turn require this app to be served over HTTPS in production
# (typically via a reverse proxy terminating TLS in front of this container).
